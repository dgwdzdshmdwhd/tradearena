# ---------------------------------------------------------------------------
# TradeArena - Vorlage fuer Umgebungsvariablen
#
# Fuer LOKAL brauchst du nichts davon: `npm run dev` startet ohne jede
# Konfiguration mit einer SQLite-Datei. Diese Datei ist fuer den Betrieb im
# Netz. Kopiere sie nach .env und trage deine Werte ein.
#
# Die echte .env steht in .gitignore und darf NIE in ein Repository wandern.
# ---------------------------------------------------------------------------

# --- Pflicht im Betrieb ----------------------------------------------------

# Schluessel fuer die Sitzungs-Cookies. Irgendeine lange Zufallszeichenkette.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ohne diesen Wert wird bei jedem Neustart ein neuer erzeugt - dann muessen
# sich alle Spieler neu anmelden.
SESSION_SECRET=

# Postgres-Verbindung. Fehlt sie, laeuft alles auf einer SQLite-Datei.
# ACHTUNG bei Render & Co: dort ist die Festplatte fluechtig, ein Deploy
# loescht die Datei. Fuer den echten Betrieb also unbedingt Postgres setzen.
# Beispiel: postgresql://benutzer:passwort@host:5432/datenbank
DATABASE_URL=

# --- Optional ---------------------------------------------------------------

# Port. Render, Fly und Koyeb setzen den selbst.
PORT=8080

# Pfad der SQLite-Datei, wenn kein Postgres konfiguriert ist.
SQLITE_PATH=tradearena.db

# Welche Krypto-Maerkte handelbar sind (Binance-Symbole, Komma-getrennt).
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,PEPEUSDT,BNBUSDT

# Wie oft die Engine offene Orders prueft (Millisekunden).
TICK_MS=250

# Wie oft Kurse an die Browser verteilt werden.
BROADCAST_MS=250

# Wie oft ein Punkt der Equity-Kurve gespeichert wird.
SNAPSHOT_MS=60000

# Auf true setzen, um ohne Internet zu entwickeln: dann erzeugt ein Simulator
# die Kurse. Die App laeuft dann vollstaendig, die Kurse sind aber erfunden.
OFFLINE=false
